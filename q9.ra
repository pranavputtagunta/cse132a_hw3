js_borrower :- \select_{cname = 'John Smith'} borrower;
js_loans :- \project_{no, minCredit} (js_borrower \join_{lno = no} loan);

l1 :- \rename_{no1, mc1} js_loans;
l2 :- \rename_{no2, mc2} js_loans;

smaller_js_loans :- \project_{no1} (
    l1 \join_{mc1 < mc2} l2
);

\rename_{loanNo} (
    (\project_{no} js_loans) \diff (\rename_{no} smaller_js_loans)
);